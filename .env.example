# VOXOPS Environment Configuration

# APP CONFIGURATION
PROJECT_NAME="VOXOPS"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# GROQ API KEY (Speech-to-Text & Reasoning LLM - Free Key from https://console.groq.com/)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# GOOGLE AI STUDIO API KEY (Multimodal & Fallback LLM - Free Key from https://aistudio.google.com/)
GOOGLE_API_KEY="AIzaSy_your_google_api_key_here"

# SUPABASE CREDENTIALS (Free Tier from https://supabase.com/)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# POSTGRES DIRECT DATABASE CONNECTION (Async SQLAlchemy)
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres"
